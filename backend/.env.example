# =====================================================
# Rooted - Bible Reading Tracker 2026
# Backend environment variables
# Copy this file to .env and fill in your real values
# =====================================================

APP_ENV=development
DEBUG=true

# --- JWT ---
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Supabase Auth (Google sign-in) ---
# Find this in Supabase Dashboard -> Project Settings -> API -> JWT Settings
# -> JWT Secret. This IS a secret - never commit it or expose it to the
# frontend. Used to verify the session token supabase-js returns after
# signInWithOAuth(google). You must also enable the Google provider under
# Authentication -> Providers in the Supabase Dashboard, and add Supabase's
# callback URL (https://YOUR_PROJECT.supabase.co/auth/v1/callback) to your
# Google Cloud OAuth Client's "Authorized redirect URIs".
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- Database (Supabase Postgres connection string) ---
# Find this in Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Church defaults ---
CHURCH_NAME=Rooted Church
READING_YEAR=2026
