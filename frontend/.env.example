# Rooted frontend environment variables
# Copy this file to .env and fill in your real values.
# Note: Vite requires the VITE_ prefix for client-exposed variables.

VITE_API_BASE_URL=/api/v1
# ^ Fine as a relative path for web/PWA (dev server + nginx proxy it).
# For the NATIVE app (Capacitor), this MUST be an absolute URL to your
# deployed backend before you run `npm run cap:sync`, e.g.:
# VITE_API_BASE_URL=https://api.yourchurch.org/api/v1

# --- Supabase Auth (Google sign-in) ---
# Required. The frontend uses supabase-js to run the Google OAuth flow
# through Supabase Auth - enable the Google provider under Authentication ->
# Providers in the Supabase Dashboard first. Both values are safe to expose
# client-side (the anon key is public by design; RLS/backend auth still
# gates real access).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
