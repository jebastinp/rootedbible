{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rooted-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host"],
      "port": 5173
